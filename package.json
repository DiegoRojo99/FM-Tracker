{
  "name": "fm-tracker",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "migrate:data": "tsx scripts/migration/migrate-data.ts",
    "migrate:help": "tsx scripts/migration/migrate-data.ts --help",
    "db:copy:prod-to-dev:dry-run": "tsx scripts/data/copy-prod-to-dev.ts --dry-run",
    "db:copy:prod-to-dev": "tsx scripts/data/copy-prod-to-dev.ts --confirm",
    "achievements:seed": "tsx scripts/data/seed-achievements.ts",
    "challenges:seed": "tsx scripts/data/seed-challenges.ts",
    "fix:promotions": "tsx scripts/data/fix-top-flight-promotions.ts",
    "competitions:export-unified": "tsx scripts/data/export-competitions-unified.ts",
    "competitions:apply-unified:dry-run": "tsx scripts/data/apply-competitions-unified.ts --dry-run --preserve-api-isfemale-non-null",
    "competitions:apply-unified": "tsx scripts/data/apply-competitions-unified.ts --preserve-api-isfemale-non-null",
    "teams:sync-gender:dry-run": "tsx scripts/data/sync-team-gender-from-competitions.ts",
    "teams:sync-gender": "tsx scripts/data/sync-team-gender-from-competitions.ts --execute",
    "teams:seed-active": "tsx scripts/data/seed-active-competitions-and-teams.ts",
    "teams:seed-active:execute": "tsx scripts/data/seed-active-competitions-and-teams.ts --execute",
    "teams:seed-active:execute:algolia": "tsx scripts/data/seed-active-competitions-and-teams.ts --execute --sync-algolia",
    "women-leagues:seed-active:female-groups": "tsx scripts/data/seed-active-competitions-and-teams.ts --only-female-groups",
    "women-leagues:seed-active:female-groups:execute": "tsx scripts/data/seed-active-competitions-and-teams.ts --execute --only-female-groups",
    "women-leagues:seed-active:female-groups:execute:algolia": "tsx scripts/data/seed-active-competitions-and-teams.ts --execute --only-female-groups --sync-algolia"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/pg": "^8.16.0",
    "@vercel/analytics": "^2.0.1",
    "algoliasearch": "^4.24.0",
    "firebase": "^11.8.1",
    "firebase-admin": "^13.6.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.511.0",
    "next": "15.4.8",
    "ol": "^10.6.1",
    "pg": "^8.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-instantsearch": "^7.15.8",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "prisma": "^7.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.8"
