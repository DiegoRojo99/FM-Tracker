generator client {
  provider   = "prisma-client-js"
  output     = "./generated/client"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum FriendRequestStatus {
  PENDING
  REJECTED
  BLOCKED
}

enum AchievementCategory {
  TROPHIES
  PROMOTIONS
  CHALLENGES
  CAREER
  SEASONS_CONSISTENCY
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum ChallengeStatus {
  DRAFT
  HIDDEN
  PUBLISHED
  RETIRED
}

enum ChallengeGoalLogic {
  ALL
  ANY
}

enum ChallengeRunStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model User {
  uid              String            @id
  email            String            @unique
  displayName      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatarURL        String?
  challengeRuns    ChallengeRun[]
  saves            Save[]
  
  // Friend request relations
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  
  // Friendship relations  
  primaryFriendships   Friendship[] @relation("User1Friendships")
  secondaryFriendships Friendship[] @relation("User2Friendships")
  achievements         UserAchievement[]

  @@index([email])
  @@index([createdAt])
}

model AchievementDefinition {
  key            String              @id
  title          String
  description    String
  category       AchievementCategory
  rarity         AchievementRarity
  points         Int
  icon           String?
  maxProgress    Int
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  userAchievements UserAchievement[]

  @@index([category])
  @@index([rarity])
  @@index([isActive])
}

model UserAchievement {
  id             String                @id @default(cuid())
  userId         String
  achievementKey String
  progress       Int                   @default(0)
  unlockedAt     DateTime?
  pointsAwarded  Int                   @default(0)
  gameId         String?
  saveId         String?
  sourceMetadata Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  achievement    AchievementDefinition @relation(fields: [achievementKey], references: [key], onDelete: Cascade, onUpdate: Cascade)
  user           User                  @relation(fields: [userId], references: [uid], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId])
  @@index([achievementKey])
  @@index([unlockedAt])
  @@index([gameId])
  @@index([saveId])
}

model FriendRequest {
  id          String              @id @default(cuid())
  requesterId String              // User who sent the friend request  
  receiverId  String              // User who received the friend request
  status      FriendRequestStatus @default(PENDING)
  requestedAt DateTime            @default(now())
  respondedAt DateTime?           // When status changed from pending
  message     String?             // Optional message with friend request
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  requester User @relation("SentFriendRequests", fields: [requesterId], references: [uid], onDelete: Cascade)
  receiver  User @relation("ReceivedFriendRequests", fields: [receiverId], references: [uid], onDelete: Cascade)
  
  @@unique([requesterId, receiverId]) // Prevent duplicate friend requests
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
  @@index([requestedAt])
}

model Friendship {
  id        String   @id @default(cuid())
  user1Id   String   // Lexically smaller user ID (ensures consistent ordering)
  user2Id   String   // Lexically larger user ID
  createdAt DateTime @default(now())
  
  user1 User @relation("User1Friendships", fields: [user1Id], references: [uid], onDelete: Cascade)
  user2 User @relation("User2Friendships", fields: [user2Id], references: [uid], onDelete: Cascade)
  
  @@unique([user1Id, user2Id]) // Prevent duplicate friendships
  @@index([user1Id])
  @@index([user2Id])
  @@index([createdAt])
}

model Save {
  id              String            @id
  userId          String
  gameId          String
  countryCode     String?
  currentClubId   Int?
  currentNTId     Int?
  currentLeagueId Int?
  season          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  challengeRuns   ChallengeRun[]
  careerStints    CareerStint[]
  currentClub     Team?             @relation("SaveCurrentClub", fields: [currentClubId], references: [id])
  currentLeague   CompetitionGroup? @relation(fields: [currentLeagueId], references: [id])
  currentNT       Team?             @relation("SaveCurrentNT", fields: [currentNTId], references: [id])
  game            Game              @relation(fields: [gameId], references: [id])
  user            User              @relation(fields: [userId], references: [uid], onDelete: Cascade)
  seasons         Season[]
  trophies        Trophy[]

  @@index([userId])
  @@index([gameId])
  @@index([season])
  @@index([createdAt])
}

model CareerStint {
  id         Int      @id @default(autoincrement())
  saveId     String
  teamId     Int
  startDate  String
  endDate    String?
  isNational Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  save       Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id])

  @@index([saveId])
  @@index([teamId])
  @@index([startDate])
}

model Season {
  id           Int           @id @default(autoincrement())
  saveId       String
  season       String
  teamId       Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cupResults   CupResult[]
  leagueResult LeagueResult?
  save         Save          @relation(fields: [saveId], references: [id], onDelete: Cascade)
  team         Team          @relation(fields: [teamId], references: [id])

  @@unique([saveId, teamId, season])
  @@index([saveId])
  @@index([teamId])
  @@index([season])
}

model CupResult {
  id            Int              @id @default(autoincrement())
  seasonId      Int
  competitionId Int
  reachedRound  String
  createdAt     DateTime         @default(now())
  competition   CompetitionGroup @relation("CupResults", fields: [competitionId], references: [id])
  season        Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, competitionId])
  @@index([seasonId])
  @@index([competitionId])
}

model LeagueResult {
  id            Int              @id @default(autoincrement())
  seasonId      Int              @unique
  competitionId Int
  position      Int
  promoted      Boolean
  relegated     Boolean
  createdAt     DateTime         @default(now())
  competition   CompetitionGroup @relation("LeagueResults", fields: [competitionId], references: [id])
  season        Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([position])
}

model Trophy {
  id                 Int              @id @default(autoincrement())
  teamId             Int
  competitionGroupId Int
  season             String
  gameId             String
  createdAt          DateTime         @default(now())
  saveId             String?
  competitionGroup   CompetitionGroup @relation(fields: [competitionGroupId], references: [id])
  game               Game             @relation(fields: [gameId], references: [id])
  save               Save?            @relation(fields: [saveId], references: [id], onDelete: Cascade)
  team               Team             @relation(fields: [teamId], references: [id])

  @@unique([competitionGroupId, season, saveId])
  @@index([teamId])
  @@index([competitionGroupId])
  @@index([gameId])
  @@index([saveId])
  @@index([season])
}

model CompetitionGroupApiCompetition {
  id                 Int              @id @default(autoincrement())
  competitionGroupId Int
  apiCompetitionId   Int
  createdAt          DateTime         @default(now())
  apiCompetition     ApiCompetition   @relation(fields: [apiCompetitionId], references: [id], onDelete: Cascade)
  competitionGroup   CompetitionGroup @relation(fields: [competitionGroupId], references: [id], onDelete: Cascade)

  @@unique([competitionGroupId, apiCompetitionId])
  @@index([competitionGroupId])
  @@index([apiCompetitionId])
}

model PromotionRelegation {
  id           Int              @id @default(autoincrement())
  fromGroupId  Int
  toGroupId    Int
  type         String
  slots        Int
  playoffSlots Int?
  createdAt    DateTime         @default(now())
  fromGroup    CompetitionGroup @relation("PromotionsFrom", fields: [fromGroupId], references: [id], onDelete: Cascade)
  toGroup      CompetitionGroup @relation("PromotionsTo", fields: [toGroupId], references: [id], onDelete: Cascade)

  @@unique([fromGroupId, toGroupId, type])
  @@index([fromGroupId])
  @@index([toGroupId])
  @@index([type])
}

model TeamSeason {
  id               Int            @id @default(autoincrement())
  teamId           Int
  apiCompetitionId Int
  season           String
  createdAt        DateTime       @default(now())
  apiCompetition   ApiCompetition @relation(fields: [apiCompetitionId], references: [id])
  team             Team           @relation(fields: [teamId], references: [id])

  @@unique([teamId, apiCompetitionId, season])
  @@index([teamId])
  @@index([apiCompetitionId])
  @@index([season])
}

model Game {
  id               String            @id
  name             String            
  shortName        String
  version          String
  platform         String
  logoUrl          String
  releaseDate      DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isActive         Boolean
  sortOrder        Int
  variant          String
  challengeRuns    ChallengeRun[]
  saves            Save[]
  trophies         Trophy[]

  @@unique([name, version, platform])
  @@index([isActive])
  @@index([sortOrder])
  @@index([releaseDate])
}

model Team {
  id                 Int                 @id
  name               String
  logo               String
  national           Boolean
  countryCode        String
  lat                Float?
  lng                Float?
  isFemale           Boolean?
  careerStints       CareerStint[]
  currentClubSaves   Save[]              @relation("SaveCurrentClub")
  currentNTSaves     Save[]              @relation("SaveCurrentNT")
  seasons            Season[]
  country            Country             @relation(fields: [countryCode], references: [code])
  teamSeasons        TeamSeason[]
  trophies           Trophy[]

  @@unique([name, countryCode])
}

model Country {
  code              String             @id @unique
  name              String             @unique
  flag              String
  inFootballManager Boolean
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  apiCompetitions   ApiCompetition[]
  competitionGroups CompetitionGroup[]
  teams             Team[]

  @@index([name])
  @@index([inFootballManager])
}

model ApiCompetition {
  id          Int                              @id @default(autoincrement())
  name        String
  countryCode String
  type        String
  logoUrl     String?
  tier        Int?
  isFemale    Boolean?
  isActive    Boolean
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  country     Country                          @relation(fields: [countryCode], references: [code])
  groups      CompetitionGroupApiCompetition[]
  teamSeasons TeamSeason[]

  @@unique([name, countryCode])
  @@index([countryCode])
  @@index([type])
  @@index([tier])
  @@index([isFemale])
  @@index([isActive])
}

model CompetitionGroup {
  id              Int                              @id @default(autoincrement())
  name            String
  displayName     String
  countryCode     String
  type            String
  tier            Int?
  isFemale        Boolean?
  logoUrl         String?
  isActive        Boolean
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  country         Country                          @relation(fields: [countryCode], references: [code])
  apiCompetitions CompetitionGroupApiCompetition[]
  cupResults      CupResult[]                      @relation("CupResults")
  leagueResults   LeagueResult[]                   @relation("LeagueResults")
  promotionsFrom  PromotionRelegation[]            @relation("PromotionsFrom")
  promotionsTo    PromotionRelegation[]            @relation("PromotionsTo")
  saves           Save[]
  trophies        Trophy[]

  @@unique([name, countryCode])
  @@index([countryCode])
  @@index([type])
  @@index([tier])
  @@index([isFemale])
  @@index([isActive])
  @@index([name])
}

model ChallengeDefinition {
  id            Int                @id @default(autoincrement())
  key           String             @unique
  title         String
  description   String
  summary       String?
  status        ChallengeStatus    @default(HIDDEN)
  sortOrder     Int                @default(0)
  tags          String[]
  metadata      Json?
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  goals         ChallengeGoal[]
  runs          ChallengeRun[]

  @@index([status])
  @@index([sortOrder])
  @@index([key])
}

model ChallengeGoal {
  id                   Int                  @id @default(autoincrement())
  challengeDefinitionId Int
  position             Int
  title                String?
  description          String
  logic                ChallengeGoalLogic   @default(ALL)
  metadata             Json?
  createdAt            DateTime             @default(now())
  challengeDefinition  ChallengeDefinition   @relation(fields: [challengeDefinitionId], references: [id], onDelete: Cascade)
  rules                ChallengeRule[]
  runGoals             ChallengeRunGoal[]

  @@unique([challengeDefinitionId, position])
  @@index([challengeDefinitionId])
  @@map("ChallengeDefinitionGoal")
}

model ChallengeRule {
  id              Int            @id @default(autoincrement())
  challengeGoalId Int
  kind            String
  subjectType     String?
  operator        String
  config          Json
  weight          Int            @default(1)
  createdAt       DateTime       @default(now())
  challengeGoal   ChallengeGoal  @relation(fields: [challengeGoalId], references: [id], onDelete: Cascade)

  @@index([challengeGoalId])
  @@index([kind])
  @@index([subjectType])
}

model ChallengeRun {
  id                    Int                  @id @default(autoincrement())
  userId                String
  saveId                String
  gameId                String
  challengeDefinitionId  Int
  status                ChallengeRunStatus   @default(ACTIVE)
  startedAt             DateTime             @default(now())
  completedAt           DateTime?
  progressSnapshot      Json?
  metadata              Json?
  challengeDefinition   ChallengeDefinition   @relation(fields: [challengeDefinitionId], references: [id], onDelete: Cascade)
  user                  User                 @relation(fields: [userId], references: [uid], onDelete: Cascade)
  save                  Save                 @relation(fields: [saveId], references: [id], onDelete: Cascade)
  game                  Game                 @relation(fields: [gameId], references: [id])
  runGoals              ChallengeRunGoal[]

  @@unique([userId, challengeDefinitionId, saveId])
  @@index([userId])
  @@index([challengeDefinitionId])
  @@index([saveId])
  @@index([gameId])
  @@index([status])
}

model ChallengeRunGoal {
  id               Int             @id @default(autoincrement())
  challengeRunId   Int
  challengeGoalId  Int
  isComplete       Boolean         @default(false)
  progress         Int             @default(0)
  completedAt      DateTime?
  evidence         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  challengeRun     ChallengeRun    @relation(fields: [challengeRunId], references: [id], onDelete: Cascade)
  challengeGoal    ChallengeGoal   @relation(fields: [challengeGoalId], references: [id], onDelete: Cascade)

  @@unique([challengeRunId, challengeGoalId])
  @@index([challengeRunId])
  @@index([challengeGoalId])
  @@index([isComplete])
}
